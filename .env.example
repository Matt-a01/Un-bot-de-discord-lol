# Token de tu bot desde Discord Developer Portal
DISCORD_TOKEN=tu_token_aqui

# ID de la aplicación (Client ID) de tu bot
CLIENT_ID=tu_client_id_aqui

# ID de tu usuario de Discord (Owner - solo tú podrás usar y dirigir las funciones de voz)
OWNER_ID=tu_user_id_aqui

# Prefijo para comandos de texto (ej. !join, !ping)
PREFIX=!

# (Opcional) ID de tu servidor de pruebas para registrar Slash Commands al instante
GUILD_ID=

# (Opcional) Si es "true", el bot entrará/seguirá automáticamente al Owner cuando entre a un canal de voz
AUTO_FOLLOW_OWNER_VOICE=false
